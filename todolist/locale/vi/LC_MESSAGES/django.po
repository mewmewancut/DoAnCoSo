msgstr "Mật khẩu phải có ít nhất 8 ký tự và không quá giống thông tin cá nhân."

# Account delete
msgid "Delete Account"
msgstr "Xóa tài khoản"

msgid "Warning: Delete Account"
msgstr "Cảnh báo: Xóa tài khoản"

msgid "This action cannot be undone!"
msgstr "Hành động này không thể hoàn tác!"

msgid "Are you sure you want to delete your account?"
msgstr "Bạn có chắc muốn xóa tài khoản của mình không?"

msgid "When deleting your account, all your data will be permanently deleted:"
msgstr "Khi xóa tài khoản, toàn bộ dữ liệu của bạn sẽ bị xóa vĩnh viễn:"

msgid "All your tasks and projects"
msgstr "Tất cả công việc và dự án của bạn"

msgid "Activity history"
msgstr "Lịch sử hoạt động"

msgid "Personal information"
msgstr "Thông tin cá nhân"

msgid "Cannot be restored after deletion"
msgstr "Không thể khôi phục sau khi xóa"

msgid "To confirm, please enter your username:"
msgstr "Để xác nhận, vui lòng nhập tên đăng nhập của bạn:"

msgid "Enter <strong>%(username)s</strong> to confirm account deletion"
msgstr "Nhập <strong>%(username)s</strong> để xác nhận xóa tài khoản"

msgid "Last warning:"
msgstr "Cảnh báo cuối cùng:"

msgid "This action will permanently delete your account <strong>%(username)s</strong> and all related data. You will not be able to log in or restore data after deletion."
msgstr "Hành động này sẽ xóa vĩnh viễn tài khoản <strong>%(username)s</strong> và toàn bộ dữ liệu liên quan. Bạn sẽ không thể đăng nhập hoặc khôi phục dữ liệu sau khi xóa."

msgid "Delete account permanently"
msgstr "Xóa tài khoản vĩnh viễn"

msgid "Username does not match!"
msgstr "Tên đăng nhập không khớp!"

msgid "Are you SURE you want to delete account"
msgstr "Bạn CÓ CHẮC muốn xóa tài khoản"

msgid "All data will be permanently deleted and cannot be restored!"
msgstr "Tất cả dữ liệu sẽ bị xóa vĩnh viễn và không thể khôi phục!"

msgid "Press OK to confirm deletion, or Cancel to cancel."
msgstr "Nhấn OK để xác nhận xóa, hoặc Cancel để hủy."

msgid "Please enter the correct username to confirm deletion!"
msgstr "Vui lòng nhập đúng tên đăng nhập để xác nhận xóa!"

