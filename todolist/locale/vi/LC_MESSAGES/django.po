msgid "Security note:"
msgstr "Lưu ý bảo mật:"

msgid "This password reset link will expire after 24 hours."
msgstr "Liên kết đặt lại mật khẩu sẽ hết hạn sau 24 giờ."

msgid "If you did not request a password reset, please ignore this email."
msgstr "Nếu bạn không yêu cầu đặt lại mật khẩu, vui lòng bỏ qua email này."

msgid "Best regards,"
msgstr "Trân trọng,"

