msgstr "Email này được gửi tự động. Vui lòng không trả lời."

msgid "You requested a password reset for your Todoist account."
msgstr "Bạn đã yêu cầu đặt lại mật khẩu cho tài khoản Todoist."

msgid "Please open the link below to reset your password:"
msgstr "Vui lòng mở liên kết dưới đây để đặt lại mật khẩu:"

msgid "Note: This link will expire after 24 hours."
msgstr "Lưu ý: Liên kết này sẽ hết hạn sau 24 giờ."

msgid "Reset your password"
msgstr "Đặt lại mật khẩu"

# Password change
msgid "Update your password to secure your account"
msgstr "Cập nhật mật khẩu để bảo vệ tài khoản của bạn"

