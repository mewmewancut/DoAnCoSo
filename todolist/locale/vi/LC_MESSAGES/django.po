msgstr "Mật khẩu mới"

msgid "Confirm new password"
msgstr "Xác nhận mật khẩu mới"

msgid "Update Password"
msgstr "Cập nhật mật khẩu"

msgid "Password Reset Complete"
msgstr "Hoàn tất đặt lại mật khẩu"

msgid "Success!"
msgstr "Thành công!"

msgid "Your password has been reset successfully. You can now log in with your new password."
msgstr "Mật khẩu của bạn đã được đặt lại thành công. Bạn có thể đăng nhập bằng mật khẩu mới."

msgid "Log in now"
msgstr "Đăng nhập ngay"

