msgstr "Email đã được gửi!"

msgid "We have sent password reset instructions to your email. Please check your inbox and follow the instructions."
msgstr "Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến email của bạn. Vui lòng kiểm tra hộp thư và làm theo hướng dẫn."

msgid "If you don't see the email, please check your spam or junk folder."
msgstr "Nếu bạn không thấy email, vui lòng kiểm tra thư rác (spam/junk)."

msgid "Back to Login"
msgstr "Quay lại đăng nhập"

msgid "Reset password"
msgstr "Đặt lại mật khẩu"

msgid "Set new password"
msgstr "Đặt mật khẩu mới"

