# Home page
msgid "Welcome to Todoist"
msgstr "Chào mừng đến với Todoist"

msgid "Finally, everything is clearer."
msgstr "Cuối cùng, mọi thứ đã rõ ràng hơn."

msgid "Organize your professional and personal life. The world's favorite task management app."
msgstr "Tổ chức cuộc sống nghề nghiệp và cá nhân của bạn. Ứng dụng quản lý công việc được yêu thích nhất trên thế giới."

msgid "Try it free"
msgstr "Dùng thử miễn phí"

msgid "from 10,000+ reviews"
msgstr "từ 10,000+ đánh giá"

msgid "FEATURES"
msgstr "TÍNH NĂNG"

msgid "Everything you need"
msgstr "Mọi thứ bạn cần"

msgid "To become the most productive employee with a comprehensive task management toolkit"
msgstr "Để trở thành nhân viên năng suất nhất với bộ công cụ quản lý công việc toàn diện"

msgid "Task Management"
msgstr "Quản lý Tác vụ"

msgid "Create, track and complete tasks easily with an intuitive and friendly interface."
msgstr "Tạo, theo dõi và hoàn thành các tác vụ một cách dễ dàng với giao diện trực quan và thân thiện."

msgid "Project Management"
msgstr "Quản lý Dự án"

msgid "Organize tasks into projects, set priorities and track progress effectively."
msgstr "Tổ chức các tác vụ thành các dự án, thiết lập mức độ ưu tiên và theo dõi tiến độ một cách hiệu quả."

msgid "Smart Reminders"
msgstr "Nhắc nhở thông minh"

msgid "Get timely notifications so you never miss any important work."
msgstr "Nhận thông báo đúng lúc để không bao giờ bỏ lỡ bất kỳ công việc quan trọng nào."

msgid "Team Collaboration"
msgstr "Cộng tác nhóm"

msgid "Share projects, assign tasks and work together seamlessly and efficiently."
msgstr "Chia sẻ dự án, giao công việc và làm việc cùng nhau một cách liền mạch và hiệu quả."

msgid "Analytics & Statistics"
msgstr "Phân tích & Thống kê"

msgid "Track productivity and view detailed statistics about your work progress."
msgstr "Theo dõi năng suất và xem thống kê chi tiết về tiến độ làm việc của bạn."

msgid "Synchronization"
msgstr "Đồng bộ hóa"

msgid "Access your work from any device, anytime, anywhere securely."
msgstr "Truy cập công việc của bạn từ mọi thiết bị, mọi lúc, mọi nơi một cách an toàn."

msgid "Active daily users"
msgstr "Người dùng hoạt động hàng ngày"

msgid "Average rating from users"
msgstr "Đánh giá trung bình từ người dùng"

msgid "Powerful features"
msgstr "Tính năng mạnh mẽ"

msgid "Start free today"
msgstr "Bắt đầu miễn phí hôm nay"

msgid "No credit card required. No commitment. Cancel anytime."
msgstr "Không cần thẻ tín dụng. Không có cam kết. Hủy bất cứ lúc nào."

msgid "Create free account"
msgstr "Tạo tài khoản miễn phí"

msgid "Ready to be more productive?"
msgstr "Sẵn sàng trở nên năng suất hơn?"

msgid "Join thousands of satisfied users and start organizing your life today."
msgstr "Tham gia hàng ngàn người dùng hài lòng và bắt đầu tổ chức cuộc sống của bạn ngay hôm nay."

# Password reset flow
msgid "Forgot password"
msgstr "Quên mật khẩu"

msgid "Forget password?"
msgstr "Quên mật khẩu?"

msgid "Don't worry! We will send one link to reset your password to your Email."
msgstr "Đừng lo! Chúng tôi sẽ gửi một liên kết để đặt lại mật khẩu đến email của bạn."

